# --- OS / editor ---
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.vscode/
.idea/

# --- Julia ---
# Manifest.toml is regenerated by `Pkg.instantiate()` and tied to the local
# package versions; keep only Project.toml under version control.
Manifest.toml
**/Manifest.toml

# --- Logs / scratch ---
*.bak
*.log
*.tmp

# --- Docker ---
# Container/image artifacts live in Docker's own storage, but stray host
# bind-mount caches sometimes appear here.
.docker-build/

# --- Preset inputs ---
# Pipeline inputs (`*.raw.json`) used by build_preset.jl are kept under
# version control for reproducibility. Exploratory Overpass dumps (search
# results, drafts) are not.
presets/_inputs/*.search.json
presets/_inputs/*.draft.json
